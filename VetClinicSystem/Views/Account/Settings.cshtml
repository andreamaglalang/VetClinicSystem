@model VetClinicSystem.Models.User

@{
    ViewData["Title"] = "Account Settings";
    var roleId = Context.Session.GetInt32("RoleId");
    var dashboardAction = roleId == 1 ? "Admin" : roleId == 2 ? "Staff" : "Client";
}

<section class="account-settings-shell">
    <div class="account-settings-header">
        <h1>Account Settings</h1>
    </div>

    <div class="account-settings-card">
        <form asp-action="Settings" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <h4>Personal Information</h4>
            <p class="text-muted">Update your personal details and account information.</p>

            @if (ViewBag.PetOwner != null)
            {
                <div class="account-settings-grid">
                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" name="FirstName" class="form-control" value="@ViewBag.FirstName" maxlength="50" minlength="2" pattern="[A-Za-z]+(?:[ '-][A-Za-z]+)*" title="Name must contain letters only and cannot include numbers or symbols." required />
                        @if (ViewBag.FirstNameError != null)
                        {
                            <span class="text-danger">@ViewBag.FirstNameError</span>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="LastName" class="form-control" value="@ViewBag.LastName" maxlength="50" minlength="2" pattern="[A-Za-z]+(?:[ '-][A-Za-z]+)*" title="Name must contain letters only and cannot include numbers or symbols." required />
                        @if (ViewBag.LastNameError != null)
                        {
                            <span class="text-danger">@ViewBag.LastNameError</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contact Number</label>
                    <input type="tel" name="ContactNumber" class="form-control" value="@ViewBag.ContactNumber" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="11" pattern="09\d{9}" title="Contact number must be 11 digits and start with 09." required />
                    @if (ViewBag.ContactNumberError != null)
                    {
                        <span class="text-danger">@ViewBag.ContactNumberError</span>
                    }
                </div>
            }

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" maxlength="30" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="account-settings-section-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>

            <hr />

            <h4>Change Password</h4>
            <p class="text-muted">Leave password fields blank if you only want to update username/email.</p>

            <div class="mb-3">
                <label class="form-label">Current Password</label>
                <input type="password" name="CurrentPassword" class="form-control" />
                @if (ViewBag.CurrentPasswordError != null)
                {
                    <span class="text-danger">@ViewBag.CurrentPasswordError</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="NewPassword" class="form-control" />
                @if (ViewBag.NewPasswordError != null)
                {
                    <span class="text-danger">@ViewBag.NewPasswordError</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="ConfirmPassword" class="form-control" />
                @if (ViewBag.ConfirmPasswordError != null)
                {
                    <span class="text-danger">@ViewBag.ConfirmPasswordError</span>
                }
            </div>

            <div class="account-settings-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="Dashboard" asp-action="@dashboardAction" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>

        <hr class="account-section-divider" />

        <section class="account-danger-zone" aria-labelledby="dangerZoneTitle">
            <div>
                <h4 id="dangerZoneTitle">Danger Zone</h4>
                <p>Deactivate your account without removing your clinic records, pets, appointments, medical records, vaccinations, or notifications.</p>
            </div>

            <form asp-action="Deactivate" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="DeactivateUsername">Confirm Username</label>
                    <input type="text" id="DeactivateUsername" name="DeactivateUsername" class="form-control" value="@ViewBag.DeactivateUsername" />
                    @if (ViewBag.DeactivateUsernameError != null)
                    {
                        <span class="text-danger">@ViewBag.DeactivateUsernameError</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label" for="DeactivatePassword">Confirm Password</label>
                    <input type="password" id="DeactivatePassword" name="DeactivatePassword" class="form-control" />
                    @if (ViewBag.DeactivatePasswordError != null)
                    {
                        <span class="text-danger">@ViewBag.DeactivatePasswordError</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label" for="DeactivateConfirmation">Type DEACTIVATE to confirm</label>
                    <input type="text" id="DeactivateConfirmation" name="DeactivateConfirmation" class="form-control" value="@ViewBag.DeactivateConfirmation" />
                    @if (ViewBag.DeactivateConfirmationError != null)
                    {
                        <span class="text-danger">@ViewBag.DeactivateConfirmationError</span>
                    }
                </div>

                <button type="submit" class="btn btn-danger">Deactivate Account</button>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
