@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-form-panel">
            <p class="auth-kicker">Welcome back</p>
            <h2>Sign in</h2>
            <p class="auth-subtitle">Access your Thrive Animal Specialist & Grooming Hub account.</p>

            @if (TempData["Success"] != null)
            {
                    <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (ViewBag.Error != null)
            {
                    <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" name="username" class="form-control auth-input" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control auth-input" />
                </div>

                <button type="submit" class="btn btn-vet-primary auth-main-btn">Login</button>

                <p class="auth-bottom-text">
                    Don’t have an account?
                    <a asp-action="Register">Register</a>
                </p>
            </form>
        </div>

        <div class="auth-visual-panel">
            <div class="auth-blob"></div>
            <div class="auth-logo-card">
                <i class="fa-solid fa-paw"></i>
                <h3>Thrive Animal Specialist</h3>
                <p>Particular. Professional. Passionate about pets.</p>
            </div>
        </div>
    </div>
</div>
