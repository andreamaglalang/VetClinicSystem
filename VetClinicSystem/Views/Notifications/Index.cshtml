@model List<VetClinicSystem.Models.StaffNotification>
@using System.Globalization

@{
    ViewData["Title"] = "Notifications";
    var roleId = Context.Session.GetInt32("RoleId");
}

@functions {
    private static string GetNotificationMessage(VetClinicSystem.Models.StaffNotification notification)
    {
        if (notification.Appointment == null)
            return notification.Message;

        if (!string.Equals(notification.Message, "New appointment has been created.", StringComparison.OrdinalIgnoreCase))
            return notification.Message;

        var appointment = notification.Appointment;
        var owner = appointment.Pet?.Owner;
        var ownerName = owner == null
            ? "A pet owner"
            : $"{owner.FirstName} {owner.LastName}".Trim();

        if (string.IsNullOrWhiteSpace(ownerName))
            ownerName = "A pet owner";

        var petName = string.IsNullOrWhiteSpace(appointment.Pet?.PetName)
            ? "the pet"
            : appointment.Pet.PetName.Trim();
        var serviceName = string.IsNullOrWhiteSpace(appointment.Service?.ServiceName)
            ? "service"
            : appointment.Service.ServiceName.Trim();
        var appointmentDate = appointment.AppointmentDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture);
        var statusName = string.IsNullOrWhiteSpace(appointment.Status?.StatusName)
            ? "Pending"
            : appointment.Status.StatusName.Trim();

        return $"{ownerName} requested a {serviceName} appointment for {petName} on {appointmentDate}. Status: {statusName}.";
    }

    private static bool IsEmergencyNotification(VetClinicSystem.Models.StaffNotification notification)
    {
        if (notification.Appointment?.IsEmergency == true)
            return true;

        return !string.IsNullOrWhiteSpace(notification.Message) &&
               notification.Message.Contains("emergency", StringComparison.OrdinalIgnoreCase);
    }
}

<div class="notifications-toolbar">
    <div>
        <h2>Notifications</h2>
    </div>
    <div class="notifications-toolbar__actions">
        <div class="notifications-toolbar__group notifications-toolbar__group--cleanup">
            <form asp-action="ArchiveRead" method="post" data-confirm-message="Archive all read notifications? Archived notifications can still be retained for clinic history.">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn notification-toolbar-btn notification-toolbar-btn--archive">
                    <i class="fa-solid fa-box-archive"></i>
                    <span>Archive All Read</span>
                </button>
            </form>
        </div>
        @if (roleId == 1)
        {
            <div class="notifications-toolbar__group notifications-toolbar__group--view">
                <a asp-action="Archived" class="btn notification-toolbar-btn notification-toolbar-btn--view">
                    <i class="fa-solid fa-folder-open"></i>
                    <span>View Archived</span>
                </a>
            </div>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No notifications found.</div>
}
else
{
    <div class="table-panel">
        <table class="table table-bordered table-striped table-notifications">
            <thead>
                <tr>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var isEmergencyNotification = IsEmergencyNotification(item);
                <tr class="notification-row @(item.IsRead ? "notification-read" : "notification-unread") @(isEmergencyNotification ? "notification-row--emergency" : string.Empty)" data-notification-row>
                    <td>
                        @if (isEmergencyNotification)
                        {
                            <div class="notification-priority-badge">
                                <span>Emergency Priority</span>
                            </div>
                        }
                        @GetNotificationMessage(item)
                    </td>
                    <td>@item.DateCreated.ToString("MMM d, yyyy h:mm tt")</td>
                    <td data-notification-status>
                        @if (item.IsRead)
                        {
                            <span class="status-pill status-pill--success">Read</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill--warning">Unread</span>
                        }
                    </td>
                    <td data-notification-action>
                        @if (!item.IsRead)
                        {
                            <a asp-action="MarkAsRead" asp-route-id="@item.Id" class="table-action-icon table-action-icon--approve" title="Mark as read" aria-label="Mark notification as read" data-mark-notification>
                                <i class="fa-solid fa-check"></i>
                            </a>
                        }

                        <form asp-action="Archive" method="post" class="notification-action-form" data-confirm-message="Archive this notification? Archived notifications can still be retained for clinic history.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="table-action-icon table-action-icon--danger" title="Archive notification" aria-label="Archive notification">
                                <i class="fa-solid fa-box-archive"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const readBadgeMarkup = '<span class="status-pill status-pill--success">Read</span>';

            document.querySelectorAll("[data-mark-notification]").forEach(function (link) {
                link.addEventListener("click", async function (event) {
                    event.preventDefault();

                    if (link.dataset.loading === "true") return;

                    const row = link.closest("[data-notification-row]");
                    const statusCell = row?.querySelector("[data-notification-status]");
                    const actionCell = row?.querySelector("[data-notification-action]");
                    if (!row || !statusCell || !actionCell) {
                        window.location.href = link.href;
                        return;
                    }

                    link.dataset.loading = "true";
                    row.classList.add("notification-row--updating");

                    try {
                        const response = await fetch(link.href, {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest",
                                "Accept": "application/json"
                            }
                        });

                        if (!response.ok) {
                            window.location.href = link.href;
                            return;
                        }

                        statusCell.innerHTML = readBadgeMarkup;
                        link.remove();
                        row.classList.remove("notification-unread", "notification-row--updating");
                        row.classList.add("notification-read");
                    } catch (error) {
                        window.location.href = link.href;
                    } finally {
                        delete link.dataset.loading;
                    }
                });
            });
        });
    </script>
}
