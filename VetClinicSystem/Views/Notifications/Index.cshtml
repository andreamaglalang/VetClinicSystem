@model List<VetClinicSystem.Models.StaffNotification>
@using System.Globalization

@{
    ViewData["Title"] = "Notifications";
}

@functions {
    private static string GetNotificationMessage(VetClinicSystem.Models.StaffNotification notification)
    {
        if (notification.Appointment == null)
            return notification.Message;

        if (!string.Equals(notification.Message, "New appointment has been created.", StringComparison.OrdinalIgnoreCase))
            return notification.Message;

        var appointment = notification.Appointment;
        var owner = appointment.Pet?.Owner;
        var ownerName = owner == null
            ? "A pet owner"
            : $"{owner.FirstName} {owner.LastName}".Trim();

        if (string.IsNullOrWhiteSpace(ownerName))
            ownerName = "A pet owner";

        var petName = string.IsNullOrWhiteSpace(appointment.Pet?.PetName)
            ? "the pet"
            : appointment.Pet.PetName.Trim();
        var serviceName = string.IsNullOrWhiteSpace(appointment.Service?.ServiceName)
            ? "service"
            : appointment.Service.ServiceName.Trim();
        var appointmentDate = appointment.AppointmentDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture);
        var statusName = string.IsNullOrWhiteSpace(appointment.Status?.StatusName)
            ? "Pending"
            : appointment.Status.StatusName.Trim();

        return $"{ownerName} requested a {serviceName} appointment for {petName} on {appointmentDate}. Status: {statusName}.";
    }
}

<h2>Notifications</h2>

@if (!Model.Any())
{
        <div class="alert alert-info">No notifications found.</div>
}
else
{
        <table class="table table-bordered table-striped table-notifications">
            <thead>
                <tr>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                    <tr>
                        <td>@GetNotificationMessage(item)</td>
                        <td>@item.DateCreated</td>
                        <td>
                        @if (item.IsRead)
                        {
                                    <span class="status-pill status-pill--success">Read</span>
                        }
                        else
                        {
                                    <span class="status-pill status-pill--warning">Unread</span>
                        }
                        </td>
                        <td>
                        @if (!item.IsRead)
                        {
                                    <a asp-action="MarkAsRead" asp-route-id="@item.Id" class="table-action-icon table-action-icon--approve" title="Mark as read" aria-label="Mark notification as read">
                                        <i class="fa-solid fa-check"></i>
                                    </a>
                        }
                        </td>
                    </tr>
            }
            </tbody>
        </table>
}
