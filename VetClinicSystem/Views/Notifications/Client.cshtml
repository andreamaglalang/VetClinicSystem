@model List<VetClinicSystem.Models.StaffNotification>

@{
    ViewData["Title"] = "My Notifications";
}

<h2>Notifications</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No notifications found.</div>
}
else
{
    <div class="table-panel">
        <table class="table table-bordered table-striped table-notifications">
            <thead>
                <tr>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="notification-row @(item.IsRead ? "notification-read" : "notification-unread")" data-notification-row>
                    <td>@item.Message</td>
                    <td>@item.DateCreated.ToString("MMM d, yyyy h:mm tt")</td>
                    <td data-notification-status>
                        @if (item.IsRead)
                        {
                            <span class="status-pill status-pill--success">Read</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill--warning">Unread</span>
                        }
                    </td>
                    <td data-notification-action>
                        @if (!item.IsRead)
                        {
                            <a asp-action="MarkAsReadClient" asp-route-id="@item.Id" class="table-action-icon table-action-icon--approve" title="Mark as read" aria-label="Mark notification as read" data-mark-notification>
                                <i class="fa-solid fa-check"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const readBadgeMarkup = '<span class="status-pill status-pill--success">Read</span>';

            document.querySelectorAll("[data-mark-notification]").forEach(function (link) {
                link.addEventListener("click", async function (event) {
                    event.preventDefault();

                    if (link.dataset.loading === "true") return;

                    const row = link.closest("[data-notification-row]");
                    const statusCell = row?.querySelector("[data-notification-status]");
                    const actionCell = row?.querySelector("[data-notification-action]");
                    if (!row || !statusCell || !actionCell) {
                        window.location.href = link.href;
                        return;
                    }

                    link.dataset.loading = "true";
                    row.classList.add("notification-row--updating");

                    try {
                        const response = await fetch(link.href, {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest",
                                "Accept": "application/json"
                            }
                        });

                        if (!response.ok) {
                            window.location.href = link.href;
                            return;
                        }

                        statusCell.innerHTML = readBadgeMarkup;
                        actionCell.innerHTML = "";
                        row.classList.remove("notification-unread", "notification-row--updating");
                        row.classList.add("notification-read");
                    } catch (error) {
                        window.location.href = link.href;
                    } finally {
                        delete link.dataset.loading;
                    }
                });
            });
        });
    </script>
}
