        <h2>Services</h2>
        <div class="medivet-slider-row medivet-service-carousel">
            <button class="medivet-arrow" type="button" aria-label="Previous service" data-service-prev><i class="fa-solid fa-chevron-left"></i></button>

            <div class="medivet-service-window">
                <div class="medivet-service-grid" id="serviceCarouselTrack">
                    <article class="medivet-photo-card medivet-card-active">
                        <img src="~/images/site/services-1.jfif" asp-append-version="true" alt="Pet consultation service" />
                        <h3>Consultation</h3>
                        <p>General health checks, diagnosis guidance, and care recommendations.</p>
                        <a href="#prices" data-price-jump="consultation">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-2.jfif" asp-append-version="true" alt="Pet supplies service" />
                        <h3>Pet Supplies</h3>
                        <p>Clinic-recommended supplies for everyday pet care and wellness.</p>
                        <a href="#prices" data-price-jump="supplies">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-3.jfif" asp-append-version="true" alt="Pet boarding service" />
                        <h3>Pet Boarding</h3>
                        <p>Temporary pet care support in a clean and monitored environment.</p>
                        <a href="#prices" data-price-jump="boarding">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-4.jfif" asp-append-version="true" alt="Pet grooming service" />
                        <h3>Pet Grooming</h3>
                        <p>Bathing, coat care, grooming, and comfort-focused pet handling.</p>
                        <a href="#prices" data-price-jump="grooming">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-5.jfif" asp-append-version="true" alt="Basic domestic test service" />
                        <h3>Basic Domestic Test</h3>
                        <p>Basic screening support for common domestic pet health concerns.</p>
                        <a href="#prices" data-price-jump="tests">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-6.jfif" asp-append-version="true" alt="Vaccination and deworming service" />
