        }
    ];

    const galleryData = [
        { src: "gallery-1.png", alt: "Clinic gallery photo 1" },
        { src: "gallery-2.png", alt: "Clinic gallery photo 2" },
        { src: "gallery-3.png", alt: "Clinic gallery photo 3" },
