@{
    ViewData["Title"] = "Home";
}

<section class="medivet-hero" id="home">
    <div class="medivet-container medivet-hero-grid">
        <div class="medivet-hero-copy">
            <h1>Professional and compassionate care for your pets</h1>
            <p>Particular. Professional. Passionate about pets.</p>
            <div class="medivet-actions">
                <a asp-controller="Account" asp-action="Register" class="btn btn-vet-primary">Book a Visit</a>
                <a href="#services" class="btn btn-vet-outline btn-vet-secondary-accent">Our Services</a>
            </div>
        </div>

        <div class="medivet-hero-visual" aria-label="Veterinary clinic dog visual">
            <img src="~/images/site/dog-cat-doctors.png" asp-append-version="true" alt="Dog and cat dressed as veterinary doctors" />
        </div>
    </div>
</section>

<section class="medivet-section medivet-wave-top" id="services">
