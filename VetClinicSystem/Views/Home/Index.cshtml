@{
    ViewData["Title"] = "Home";
}
    
<section class="medivet-hero" id="home">
    <div class="medivet-container medivet-hero-grid">
        <div class="medivet-hero-copy">
            <h1>Professional and compassionate care for your pets</h1>
            <p>Particular. Professional. Passionate about pets.</p>
            <div class="medivet-actions">
                <a asp-controller="Appointments" asp-action="GuestCreate" class="btn btn-vet-primary">Book Surgery</a>
                <a href="#services" class="btn btn-vet-outline btn-vet-secondary-accent">Our Services</a>
            </div>
        </div>

        <div class="medivet-hero-visual" aria-label="Veterinary clinic dog visual">
            <img src="~/images/site/dog-cat-doctors.png" asp-append-version="true" alt="Corgi dressed as a veterinary doctor" />
        </div>
    </div>
</section>  

<section class="medivet-section medivet-wave-top" id="services">
    <div class="medivet-container">
        <h2>Services</h2>
        <div class="medivet-slider-row medivet-service-carousel">
            <button class="medivet-arrow" type="button" aria-label="Previous service" data-service-prev><i class="fa-solid fa-chevron-left"></i></button>

            <div class="medivet-service-window">
                <div class="medivet-service-grid" id="serviceCarouselTrack">
                    <article class="medivet-photo-card medivet-card-active">
                        <img src="~/images/site/services-1.jfif" asp-append-version="true" alt="Pet consultation service" />
                        <h3>Consultation</h3>
                        <p>General health checks, diagnosis guidance, and care recommendations. Walk-in only.</p>
                        <a href="#prices" data-price-jump="consultation">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-2.jfif" asp-append-version="true" alt="Pet supplies service" />
                        <h3>Pet Supplies</h3>
                        <p>Clinic-recommended supplies for everyday pet care and wellness. Walk-in only.</p>
                        <a href="#prices" data-price-jump="supplies">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-3.jfif" asp-append-version="true" alt="Pet boarding service" />
                        <h3>Pet Boarding</h3>
                        <p>Temporary pet care support in a clean and monitored environment. Walk-in only.</p>
                        <a href="#prices" data-price-jump="boarding">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-4.jfif" asp-append-version="true" alt="Pet grooming service" />
                        <h3>Pet Grooming</h3>
                        <p>Bathing, coat care, grooming, and comfort-focused pet handling. Walk-in only.</p>
                        <a href="#prices" data-price-jump="grooming">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-5.jfif" asp-append-version="true" alt="Basic domestic test service" />
                        <h3>Basic Domestic Test</h3>
                        <p>Basic screening support for common domestic pet health concerns. Walk-in only.</p>
                        <a href="#prices" data-price-jump="tests">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-6.jfif" asp-append-version="true" alt="Vaccination and deworming service" />
                        <h3>Vaccination and Deworming</h3>
                        <p>Preventive care to help protect pets from parasites and disease. Walk-in only.</p>
                        <a href="#prices" data-price-jump="vaccination">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-7.jfif" asp-append-version="true" alt="Confinement service" />
                        <h3>Confinement</h3>
                        <p>Clinic observation and care for pets needing close monitoring. Walk-in only.</p>
                        <a href="#prices" data-price-jump="confinement">Details</a>
                    </article>
                    <article class="medivet-photo-card">
                        <img src="~/images/site/services-8.jfif" asp-append-version="true" alt="Surgery service" />
                        <h3>Surgery</h3>
                        <p>Pre-op blood test screening is walk-in only. If fit, surgery should be scheduled within 1 week.</p>
                        <a href="#prices" data-price-jump="surgery">Details</a>
                    </article>
                </div>
            </div>

            <button class="medivet-arrow" type="button" aria-label="Next service" data-service-next><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <div class="medivet-dots" id="serviceCarouselDots" aria-label="Service carousel position"></div>
    </div>
</section>

<section class="medivet-section" id="prices">
    <div class="medivet-container">
        <h2>Prices</h2>
        <div class="medivet-tab-row">
            <button class="medivet-tab-arrow" type="button" aria-label="Previous price category" data-tab-prev><i class="fa-solid fa-chevron-left"></i></button>
            <div class="medivet-tabs" id="priceTabs" role="group" aria-label="Price categories">
                <button class="active" type="button" data-price-tab="consultation" aria-pressed="true">Consultation</button>
                <button type="button" data-price-tab="supplies" aria-pressed="false">Pet Supplies</button>
                <button type="button" data-price-tab="boarding" aria-pressed="false">Pet Boarding</button>
                <button type="button" data-price-tab="grooming" aria-pressed="false">Pet Grooming</button>
                <button type="button" data-price-tab="tests" aria-pressed="false">Basic Test</button>
                <button type="button" data-price-tab="vaccination" aria-pressed="false">Vaccination</button>
                <button type="button" data-price-tab="confinement" aria-pressed="false">Confinement</button>
                <button type="button" data-price-tab="surgery" aria-pressed="false">Surgery</button>
            </div>
            <button class="medivet-tab-arrow" type="button" aria-label="Next price category" data-tab-next><i class="fa-solid fa-chevron-right"></i></button>
        </div>

        <div class="medivet-price-layout">
            <img class="medivet-price-photo" id="pricePhoto" src="~/images/site/prices-1.jfif" asp-append-version="true" alt="Veterinarian consulting about pet care" />
            <div class="medivet-price-panel">
                <table>
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Description</th>
                            <th>Fee</th>
                        </tr>
                    </thead>
                    <tbody id="priceTableBody">
                        <tr><td>Initial consultation</td><td>General health check</td><td>Contact clinic</td></tr>
                        <tr><td>Repeat consultation</td><td>Follow-up visit</td><td>Contact clinic</td></tr>
                        <tr><td>Blood test screening</td><td>Laboratory</td><td>Contact clinic</td></tr>
                        <tr><td>Health certificate</td><td>Clinic documentation</td><td>Contact clinic</td></tr>
                    </tbody>
                </table>
                <p class="medivet-price-disclaimer">
                    Prices are subject to change without prior notice. We reserve the right to modify service and product rates at any time. For updated pricing, please contact us directly.
                </p>
                <div class="medivet-actions">
                    <a asp-controller="Appointments" asp-action="GuestCreate" class="btn btn-vet-primary">Book Surgery</a>
                </div>
            </div>
        </div>
    </div>
</section>

