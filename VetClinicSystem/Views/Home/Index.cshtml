    function setActiveButton(buttons, activeButton) {
        buttons.forEach(function (button) {
            const isActive = button === activeButton;
            button.classList.toggle("active", isActive);
            button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
    }

    function setupToggleKeyboard(container) {
        const buttons = Array.from(container.querySelectorAll("button"));
        if (!buttons.length) return;

        buttons.forEach(function (button) {
            button.addEventListener("keydown", function (event) {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

                event.preventDefault();

                const activeIndex = Math.max(0, buttons.findIndex(function (item) {
                    return item.classList.contains("active");
                }));
                const direction = event.key === "ArrowRight" ? 1 : -1;
                const nextIndex = (activeIndex + direction + buttons.length) % buttons.length;

                buttons[nextIndex].focus();
                buttons[nextIndex].click();
            });
        });
    }

    function setupServiceCarousel() {
        const track = document.getElementById("serviceCarouselTrack");
        const dots = document.getElementById("serviceCarouselDots");
        const previousButton = document.querySelector("[data-service-prev]");
        const nextButton = document.querySelector("[data-service-next]");

        if (!track || !dots || !previousButton || !nextButton) return;

        const cards = Array.from(track.querySelectorAll(".medivet-photo-card"));
        let currentIndex = 0;

        function renderDots() {
            dots.innerHTML = "";
            cards.forEach(function (_, index) {
                const dot = document.createElement("button");
                dot.type = "button";
                dot.className = index === currentIndex ? "active" : "";
                dot.setAttribute("aria-label", "Show service " + (index + 1));
                dot.addEventListener("click", function () {
                    currentIndex = index;
                    updateCarousel();
                });
                dots.appendChild(dot);
            });
        }

        function updateCarousel() {
            cards.forEach(function (card, index) {
                let position = index - currentIndex;

                if (position > cards.length / 2) {
                    position -= cards.length;
                }

                if (position < -cards.length / 2) {
                    position += cards.length;
                }

                card.classList.remove(
                    "medivet-card-active",
                    "medivet-card-left",
                    "medivet-card-right",
                    "medivet-card-far-left",
                    "medivet-card-far-right"
                );

                if (position === 0) {
                    card.classList.add("medivet-card-active");
                } else if (position === -1) {
                    card.classList.add("medivet-card-left");
                } else if (position === 1) {
                    card.classList.add("medivet-card-right");
                } else if (position === -2) {
                    card.classList.add("medivet-card-far-left");
                } else if (position === 2) {
                    card.classList.add("medivet-card-far-right");
                }
            });

            Array.from(dots.children).forEach(function (dot, index) {
                dot.classList.toggle("active", index === currentIndex);
            });
        }

        function moveCarousel(direction) {
            currentIndex = (currentIndex + direction + cards.length) % cards.length;
            updateCarousel();
        }

        previousButton.addEventListener("click", function () {
            moveCarousel(-1);
        });

        nextButton.addEventListener("click", function () {
            moveCarousel(1);
        });

        window.addEventListener("resize", function () {
            renderDots();
            updateCarousel();
        });

        renderDots();
        updateCarousel();
    }

    function setupPriceTabs() {
        const buttons = Array.from(document.querySelectorAll("[data-price-tab]"));
        const jumpLinks = Array.from(document.querySelectorAll("[data-price-jump]"));
        const pricesSection = document.getElementById("prices");
        const photo = document.getElementById("pricePhoto");
        const body = document.getElementById("priceTableBody");

        if (!buttons.length || !photo || !body) return;

        function render(key, activeButton) {
            const data = priceData[key];
            if (!data) return;

            setActiveButton(buttons, activeButton);
            photo.src = imageBase + data.photo;
            body.innerHTML = data.rows.map(function (row) {
                return "<tr><td>" + row[0] + "</td><td>" + row[1] + "</td><td>" + row[2] + "</td></tr>";
            }).join("");
        }

        function activatePrice(key) {
            const button = buttons.find(function (item) {
                return item.dataset.priceTab === key;
            });

            if (!button) return;

            render(key, button);
            button.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        }

        buttons.forEach(function (button) {
            button.addEventListener("click", function () {
                render(button.dataset.priceTab, button);
            });
        });

        jumpLinks.forEach(function (link) {
            link.addEventListener("click", function (event) {
                event.preventDefault();
                activatePrice(link.dataset.priceJump);
                pricesSection?.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        });
    }

    function setupSpecialists() {
        const tabButtons = Array.from(document.querySelectorAll("[data-specialist-tab]"));
        const listButtons = Array.from(document.querySelectorAll("[data-specialist-button]"));
        const photo = document.getElementById("specialistPhoto");
        const name = document.getElementById("specialistName");
        const description = document.getElementById("specialistDescription");
        const skills = document.getElementById("specialistSkills");

        if (!tabButtons.length || !listButtons.length || !photo || !name || !description || !skills) return;

        function render(index) {
            const data = specialistData[index];
            if (!data) return;

            setActiveButton(tabButtons, tabButtons[index]);
            setActiveButton(listButtons, listButtons[index]);
            photo.src = imageBase + data.photo;
            name.textContent = data.name;
            description.textContent = data.description;
            skills.innerHTML = data.skills.map(function (skill) {
                return "<li>" + skill + "</li>";
            }).join("");
        }

        tabButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                render(Number(button.dataset.specialistTab));
            });
        });

        listButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                render(Number(button.dataset.specialistButton));
            });
        });
    }

    function setupGallery() {
        const images = Array.from(document.querySelectorAll("[data-gallery-image]"));
        const dots = document.getElementById("galleryDots");
        const previousButton = document.querySelector("[data-gallery-prev]");
        const nextButton = document.querySelector("[data-gallery-next]");

        if (!images.length || !dots || !previousButton || !nextButton) return;

        let currentIndex = 0;

        function renderDots() {
            dots.innerHTML = "";
            galleryData.forEach(function (_, index) {
                const dot = document.createElement("button");
                dot.type = "button";
                dot.className = index === currentIndex ? "active" : "";
                dot.setAttribute("aria-label", "Show gallery image " + (index + 1));
                dot.addEventListener("click", function () {
                    currentIndex = index;
                    render();
                });
                dots.appendChild(dot);
            });
        }

        function render() {
            images.forEach(function (image, offset) {
                const data = galleryData[(currentIndex + offset) % galleryData.length];
                image.src = imageBase + data.src;
                image.alt = data.alt;
                image.classList.toggle("active", offset === Math.floor(images.length / 2));
            });

            Array.from(dots.children).forEach(function (dot, index) {
                dot.classList.toggle("active", index === currentIndex);
            });
        }

        previousButton.addEventListener("click", function () {
            currentIndex = currentIndex === 0 ? galleryData.length - 1 : currentIndex - 1;
            render();
        });

        nextButton.addEventListener("click", function () {
            currentIndex = (currentIndex + 1) % galleryData.length;
            render();
        });

        renderDots();
        render();
    }

    function setupArticles() {
        const buttons = Array.from(document.querySelectorAll("[data-article-tab]"));
        const grid = document.getElementById("articleGrid");

        if (!buttons.length || !grid) return;

        function render(key, activeButton) {
            const data = articleData[key];
            if (!data) return;

            setActiveButton(buttons, activeButton);
            grid.innerHTML = data.map(function (article) {
                if (article.featured) {
                    return "<article class=\"featured\"><h3>" + article.title + "</h3><p>" + article.text + "</p><a href=\"#contact\">Read Article</a></article>";
                }

                return "<article><img src=\"" + imageBase + article.image + "\" alt=\"" + article.title + "\" /><h3>" + article.title + "</h3></article>";
            }).join("");
        }

        buttons.forEach(function (button) {
            button.addEventListener("click", function () {
                render(button.dataset.articleTab, button);
            });
        });
    }

    function setupServiceRequestForm() {
        const form = document.querySelector("[data-service-request-form]");
        const serviceSelect = document.querySelector("[data-service-request-select]");
        const feedback = document.querySelector("[data-service-request-feedback]");

        if (!form || !serviceSelect || !feedback) return;

        function getSelectedMode() {
            return serviceSelect.selectedOptions[0]?.dataset.requestMode || "";
        }

        function updateFeedback() {
            const serviceName = serviceSelect.value;
            const mode = getSelectedMode();

            feedback.classList.remove("is-error", "is-success");

            if (!serviceName) {
                feedback.textContent = "";
                return;
            }

            if (mode === "appointment") {
                feedback.textContent = "Surgery requests continue to the guest booking form for pet details, preferred date, and clinic confirmation.";
                feedback.classList.add("is-success");
                return;
            }

            feedback.textContent = serviceName + " is walk-in only. Please visit the clinic during open hours or contact us directly for availability and pricing.";
        }

        serviceSelect.addEventListener("change", updateFeedback);

        form.addEventListener("submit", function (event) {
            event.preventDefault();

            if (!form.reportValidity()) return;

            if (getSelectedMode() !== "appointment") {
                updateFeedback();
                feedback.classList.add("is-error");
                serviceSelect.focus();
                return;
            }

            const params = new URLSearchParams(new FormData(form));
            window.location.href = "/Appointments/GuestCreate?" + params.toString();
        });

        updateFeedback();
    }

    function setupTabArrows() {
        const rows = Array.from(document.querySelectorAll(".medivet-tab-row"));

        rows.forEach(function (row) {
            const tabContainer = row.querySelector(".medivet-tabs");
            const tabs = Array.from(row.querySelectorAll(".medivet-tabs button"));
            const previousButton = row.querySelector("[data-tab-prev]");
            const nextButton = row.querySelector("[data-tab-next]");

            if (!tabs.length || !previousButton || !nextButton) return;

            if (tabContainer) {
                setupToggleKeyboard(tabContainer);
            }

            function move(direction) {
                const activeIndex = Math.max(0, tabs.findIndex(function (tab) {
                    return tab.classList.contains("active");
                }));
                const nextIndex = (activeIndex + direction + tabs.length) % tabs.length;
                const nextTab = tabs[nextIndex];

                nextTab.click();

                if (!tabContainer) return;

                const containerRect = tabContainer.getBoundingClientRect();
                const tabRect = nextTab.getBoundingClientRect();
                const targetLeft = tabContainer.scrollLeft
                    + (tabRect.left - containerRect.left)
                    - (containerRect.width / 2)
                    + (tabRect.width / 2);

                tabContainer.scrollTo({ left: Math.max(0, targetLeft), behavior: "smooth" });
            }

            previousButton.addEventListener("click", function () {
                move(-1);
            });

            nextButton.addEventListener("click", function () {
                move(1);
            });
        });
    }

    setupServiceCarousel();
    setupPriceTabs();
    setupArticles();
    setupServiceRequestForm();
    setupTabArrows();
});
</script>
}
