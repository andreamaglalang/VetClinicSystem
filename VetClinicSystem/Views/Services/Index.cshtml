@model IEnumerable<VetClinicSystem.Models.Service>

<h2>Services</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Service</a>
</p>

<table class="table table-bordered table-services">
    <thead>
        <tr>
            <th>Service Name</th>
            <th>Description</th>
            <th>Walk-in Only</th>
            <th>Requires Appointment</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ServiceName</td>
                <td>@item.Description</td>
                <td>@item.IsWalkInOnly</td>
                <td>@item.RequiresAppointment</td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="table-action-icon table-action-icon--details" title="Details" aria-label="View service details">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="table-action-icon table-action-icon--edit" title="Edit" aria-label="Edit service">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="table-action-icon table-action-icon--delete" title="Delete" aria-label="Delete service">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
