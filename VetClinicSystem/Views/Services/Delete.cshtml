@model VetClinicSystem.Models.Service

<h2>Delete Service</h2>

<table class="table table-bordered">
    <tr><th>Name</th><td>@Model.ServiceName</td></tr>
</table>

<form asp-action="Delete" asp-controller="Services" method="post" data-confirm-message="Are you sure you want to delete this service?">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
