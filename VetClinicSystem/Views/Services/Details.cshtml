@model VetClinicSystem.Models.Service

<h2>Service Details</h2>

<table class="table table-bordered">
    <tr><th>Name</th><td>@Model.ServiceName</td></tr>
    <tr><th>Description</th><td>@Model.Description</td></tr>
    <tr><th>Walk-in Only</th><td>@Model.IsWalkInOnly</td></tr>
    <tr><th>Requires Appointment</th><td>@Model.RequiresAppointment</td></tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>