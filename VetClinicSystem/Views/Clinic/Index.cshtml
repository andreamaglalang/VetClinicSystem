@model VetClinicSystem.Models.ClinicInfo

<h2>Clinic Information</h2>

@if (Model == null)
{
        <div class="alert alert-warning">No clinic information yet.</div>
        <a asp-action="Edit" class="btn btn-primary">Add Clinic Info</a>
}
else
{
        <table class="table table-bordered">
            <tr><th>Clinic Name</th><td>@Model.ClinicName</td></tr>
            <tr><th>Address</th><td>@Model.Address</td></tr>
            <tr><th>Contact Number</th><td>@Model.ContactNumber</td></tr>
            <tr><th>Email</th><td>@Model.Email</td></tr>
            <tr><th>Operating Hours</th><td>@Model.OperatingHours</td></tr>
            <tr><th>Facebook Page</th><td>@Model.FacebookPage</td></tr>
            <tr><th>About</th><td>@Model.AboutText</td></tr>
        </table>

        <a asp-action="Edit" class="btn btn-primary">Edit</a>
}