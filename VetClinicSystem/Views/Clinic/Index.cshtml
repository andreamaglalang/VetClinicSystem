@model VetClinicSystem.Models.ClinicInfo

<h2>Clinic Information</h2>

@if (Model != null)
{
        <p><strong>Clinic Name:</strong> @Model.ClinicName</p>
        <p><strong>Address:</strong> @Model.Address</p>
        <p><strong>Contact Number:</strong> @Model.ContactNumber</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Operating Hours:</strong> @Model.OperatingHours</p>
        <p><strong>Facebook:</strong> @Model.FacebookPage</p>
        <p><strong>About:</strong> @Model.AboutText</p>

        <a asp-action="Edit" class="btn btn-primary">Edit</a>
}
else
{
        <p>No clinic information found.</p>
}