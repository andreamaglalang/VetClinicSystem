@model VetClinicSystem.Models.ClinicInfo
@{
    var isAdmin = Context.Session.GetInt32("RoleId") == 1;
    var clinicName = "Thrive Animal Specialist & Grooming Hub";
    var address = "258, Unit 4, Sto. Rosario St., Brgy. San Jose, Angeles City, Pampanga";
    var contactNumber = "0969-644-0381";
    var email = "thriveanimalspecialist@gmail.com";
    var facebookPage = "https://www.facebook.com/share/1KmWxCrZmF/";
    var about = "Thrive Animal Specialist & Grooming Hub is a veterinary clinic in Angeles City, Pampanga that provides pet care services such as consultation, grooming, vaccination and deworming, basic diagnostic tests, confinement, pet boarding, pet supplies, and surgery support.";
}

<h2>Clinic Information</h2>

<table class="table table-bordered">
    <tr><th>Clinic Name</th><td>@clinicName</td></tr>
    <tr><th>Address</th><td>@address</td></tr>
    <tr><th>Contact Number</th><td>@contactNumber</td></tr>
    <tr><th>Email</th><td>@email</td></tr>
    <tr>
        <th>Operating Hours</th>
        <td>
            Monday: 9:00 AM - 5:00 PM<br />
            Tuesday: Closed<br />
            Wednesday - Sunday: 9:00 AM - 7:00 PM
        </td>
    </tr>
    <tr><th>Facebook Page</th><td><a href="@facebookPage" target="_blank" rel="noopener">@facebookPage</a></td></tr>
    <tr><th>About</th><td>@about</td></tr>
</table>

@if (isAdmin)
{
    if (Model == null)
    {
        <a asp-action="Edit" class="btn btn-primary">Add Clinic Info</a>
    }
    else
    {
        <a asp-action="Edit" class="btn btn-primary">Edit</a>
    }
}
