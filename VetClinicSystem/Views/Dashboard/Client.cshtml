@{
    ViewData["Title"] = "Client Dashboard";
    var today = DateTime.Today;
    var firstDay = new DateTime(today.Year, today.Month, 1);
    var startOffset = ((int)firstDay.DayOfWeek + 6) % 7;
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var currentUser = ViewBag.CurrentUser as VetClinicSystem.Models.User;
    var petOwner = ViewBag.PetOwner as VetClinicSystem.Models.PetOwner;
    var displayName = petOwner != null
        ? $"{petOwner.FirstName} {petOwner.LastName}".Trim()
        : (currentUser?.Username ?? "Pet Parent");
    var displayEmail = currentUser?.Email ?? "No email provided";
    var appointments = ViewBag.ClientAppointments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var upcomingReminders = ViewBag.UpcomingReminders as IEnumerable<VetClinicSystem.Models.Appointment> ?? Enumerable.Empty<VetClinicSystem.Models.Appointment>();
    var followUpAppointments = ViewBag.FollowUpAppointments as IEnumerable<VetClinicSystem.Models.Appointment> ?? Enumerable.Empty<VetClinicSystem.Models.Appointment>();
    var overdueVaccinations = ViewBag.OverdueVaccinations as IEnumerable<VetClinicSystem.Models.VaccinationRecord> ?? Enumerable.Empty<VetClinicSystem.Models.VaccinationRecord>();
    var recentTreatmentHistory = ViewBag.RecentTreatmentHistory as IEnumerable<VetClinicSystem.Models.MedicalRecord> ?? Enumerable.Empty<VetClinicSystem.Models.MedicalRecord>();
    var monthAppointmentDays = appointments
        .Where(x => DateTime.TryParse((string)x.date, out var date) && date.Year == today.Year && date.Month == today.Month)
        .Select(x => (int)x.day)
        .Distinct()
        .ToList();
    var appointmentJson = System.Text.Json.JsonSerializer.Serialize(appointments);
}

<section class="med-dashboard">
    <div class="med-main-panel">
        <div class="med-topbar">
            <div>
                <h1>Hello, @displayName!</h1>
                <span>@today.ToString("dd MMMM yyyy, dddd")</span>
            </div>
            <label class="med-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" id="dashboardSearch" placeholder="Search dashboard" />
            </label>
        </div>

        <div class="med-hero-grid">
            <article class="med-welcome-card">
                <div>
                    <p>Welcome back...</p>
                    <h2>Your pets are in caring hands.</h2>
                    <a asp-controller="Appointments" asp-action="Create" class="med-icon-link" title="Book appointment">
                        <i class="fa-solid fa-plus"></i>
                    </a>
                </div>
            </article>

            <article class="med-results-card">
                <span>Latest results</span>
                <h2>Care summary</h2>
                <div class="result-row">
                    <span>Pets</span>
                    <div><b style="width: 72%"></b></div>
                    <strong>@ViewBag.TotalPets</strong>
                </div>
                <div class="result-row">
                    <span>Visits</span>
                    <div><b style="width: 58%"></b></div>
                    <strong>@ViewBag.TotalAppointments</strong>
                </div>
                <div class="result-row">
                    <span>Health</span>
                    <div><b style="width: 86%"></b></div>
                    <strong>Good</strong>
                </div>
            </article>
        </div>

        <div class="med-action-row">
            <a asp-controller="Pets" asp-action="Index" class="med-action-card" data-dashboard-item="pets my pets registered">
                <span><i class="fa-solid fa-paw"></i></span>
                <div><strong>My Pets</strong><small>@ViewBag.TotalPets registered</small></div>
                <i class="fa-solid fa-plus"></i>
            </a>
            <a asp-controller="Appointments" asp-action="Index" class="med-action-card" data-dashboard-item="appointments scheduled visit">
                <span><i class="fa-regular fa-calendar-check"></i></span>
                <div><strong>Appointments</strong><small>@ViewBag.TotalAppointments scheduled</small></div>
                <i class="fa-solid fa-plus"></i>
            </a>
            <a asp-controller="Vaccinations" asp-action="Index" class="med-action-card" data-dashboard-item="vaccines vaccination records">
                <span><i class="fa-solid fa-syringe"></i></span>
                <div><strong>Vaccines</strong><small>Review records</small></div>
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>

        <section class="med-calendar-card">
            <div class="calendar-head">
                <button type="button" class="calendar-nav-button" id="calendarPrev" aria-label="Previous month">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div>
                    <h2 id="calendarMonth">@today.ToString("MMMM")</h2>
                    <span id="calendarYear">@today.Year</span>
                </div>
                <button type="button" class="calendar-nav-button" id="calendarNext" aria-label="Next month">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
            <div class="calendar-grid calendar-weekdays">
                <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
            </div>
            <div class="calendar-grid calendar-days" id="calendarDays">
                @for (var i = 0; i < startOffset; i++)
                {
                    <span class="muted"></span>
                }
                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var hasAppointment = monthAppointmentDays.Contains(day);
                    var classes = $"{(day == today.Day ? "today" : "")} {(hasAppointment ? "has-appointment" : "")}".Trim();
                    if (hasAppointment)
                    {
                        <button type="button" class="@classes" data-appointment-day="@day" aria-label="View appointments on @today.ToString("MMMM") @day">@day</button>
                    }
                    else
                    {
                        <span class="@classes">@day</span>
                    }
                }
            </div>
            <div class="appointment-popover" id="appointmentPopover" hidden>
                <button type="button" class="appointment-close" id="appointmentPopoverClose" aria-label="Close appointment details"><i class="fa-solid fa-xmark"></i></button>
                <span><i class="fa-regular fa-bell"></i></span>
                <h3 id="appointmentPopoverTitle">Appointment</h3>
                <p id="appointmentPopoverReason">Routine checkup</p>
                <strong id="appointmentPopoverDate"></strong>
                <small id="appointmentPopoverTime"></small>
            </div>
        </section>
    </div>

    <aside class="med-profile-panel">
        <div class="profile-avatar"><i class="fa-solid fa-user"></i></div>
        <h2>@displayName</h2>
        <p>@displayEmail</p>
        <div class="profile-stats">
            <strong>@ViewBag.TotalPets<small>Pets</small></strong>
            <strong>@ViewBag.TotalAppointments<small>Visits</small></strong>
            <strong>A+<small>Care</small></strong>
        </div>
        <div class="profile-note">
            <span>@today.ToString("dd/MM/yyyy")</span>
            <h3>Recent Result</h3>
            @if (recentTreatmentHistory.Any())
            {
                var latestRecord = recentTreatmentHistory.First();
                <p>@latestRecord.Pet?.PetName: @(latestRecord.Treatment ?? latestRecord.Diagnosis ?? "Latest treatment record")</p>
            }
            else
            {
                <p>Your pet care overview is up to date. Review upcoming appointments and vaccination reminders.</p>
            }
        </div>
        <div class="reminder-list">
            <h3>Reminders</h3>
            @foreach (var appointment in upcomingReminders)
            {
                <a asp-controller="Appointments" asp-action="Index" data-dashboard-item="appointment reminder scheduled">
                    <i class="fa-regular fa-envelope"></i>
                    <span>Appointment reminder<small>@appointment.Pet?.PetName - @appointment.AppointmentDate.ToString("MMM d")</small></span>
                </a>
            }
            @foreach (var appointment in followUpAppointments)
            {
                <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" data-dashboard-item="follow-up after visit">
                    <i class="fa-solid fa-notes-medical"></i>
                    <span>Follow-up after visit<small>@appointment.Pet?.PetName - @appointment.AppointmentDate.ToString("MMM d")</small></span>
                </a>
            }
            @foreach (var vaccination in overdueVaccinations)
            {
                <a asp-controller="Vaccinations" asp-action="Index" data-dashboard-item="overdue vaccination alert">
                    <i class="fa-solid fa-syringe"></i>
                    <span>Overdue vaccination<small>@vaccination.Pet?.PetName - @vaccination.VaccineName</small></span>
                </a>
            }
            @if (!upcomingReminders.Any() && !followUpAppointments.Any() && !overdueVaccinations.Any())
            {
                <a asp-controller="Vaccinations" asp-action="Index" data-dashboard-item="vaccination record schedule"><i class="fa-solid fa-syringe"></i><span>Vaccination record<small>Review schedule</small></span></a>
                <a asp-controller="MedicalRecords" asp-action="Index" data-dashboard-item="medical records latest notes"><i class="fa-solid fa-file-medical"></i><span>Medical records<small>Latest notes</small></span></a>
            }
        </div>
    </aside>
</section>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const appointments = @Html.Raw(appointmentJson);
    const popover = document.getElementById("appointmentPopover");
    const closeButton = document.getElementById("appointmentPopoverClose");
    const title = document.getElementById("appointmentPopoverTitle");
    const reason = document.getElementById("appointmentPopoverReason");
    const date = document.getElementById("appointmentPopoverDate");
    const time = document.getElementById("appointmentPopoverTime");
    const calendarMonth = document.getElementById("calendarMonth");
    const calendarYear = document.getElementById("calendarYear");
    const calendarDays = document.getElementById("calendarDays");
    const calendarPrev = document.getElementById("calendarPrev");
    const calendarNext = document.getElementById("calendarNext");
    const todayInfo = {
        year: @today.Year,
        month: @(today.Month - 1),
        day: @today.Day
    };
    let visibleYear = todayInfo.year;
    let visibleMonth = todayInfo.month;

    function formatDate(value) {
        const parsed = new Date(value + "T00:00:00");
        return parsed.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
    }

    function toDateKey(year, month, day) {
        return year + "-" + String(month + 1).padStart(2, "0") + "-" + String(day).padStart(2, "0");
    }

    function formatTime(value) {
        if (!value) return "Scheduled";

        const parts = value.split(":");
        if (parts.length < 2) return value;

        let hour = Number(parts[0]);
        const minute = parts[1];
        if (Number.isNaN(hour)) return value;

        const period = hour >= 12 ? "PM" : "AM";
        hour = hour % 12 || 12;

        return hour + ":" + minute + " " + period;
    }

    function placePopover(anchor) {
        if (!popover || !anchor) return;

        const calendarCard = anchor.closest(".med-calendar-card");
        if (!calendarCard) return;

        popover.hidden = false;
        popover.classList.add("is-visible");

        const cardRect = calendarCard.getBoundingClientRect();
        const anchorRect = anchor.getBoundingClientRect();
        const popoverWidth = popover.offsetWidth;
        const popoverHeight = popover.offsetHeight;
        const gap = 14;
        const padding = 14;

        let left = anchorRect.right - cardRect.left + gap;
        let top = anchorRect.top - cardRect.top + (anchorRect.height / 2) - (popoverHeight / 2);

        if (left + popoverWidth > cardRect.width - padding) {
            left = anchorRect.left - cardRect.left - popoverWidth - gap;
        }

        if (left < padding) {
            left = Math.min(cardRect.width - popoverWidth - padding, anchorRect.left - cardRect.left);
            top = anchorRect.bottom - cardRect.top + gap;
        }

        top = Math.max(padding, Math.min(top, cardRect.height - popoverHeight - padding));

        popover.style.left = left + "px";
        popover.style.top = top + "px";
    }

    function hidePopover() {
        if (!popover) return;

        popover.hidden = true;
        popover.classList.remove("is-visible");
        document.querySelectorAll("[data-appointment-date]").forEach(function (button) {
            button.classList.remove("is-selected");
        });
    }

    function showAppointment(anchor) {
        const appointmentDate = anchor.dataset.appointmentDate;
        const appointment = appointments.find(function (item) { return item.date === appointmentDate; });
        if (!appointment || !popover) return;

        document.querySelectorAll("[data-appointment-date]").forEach(function (dateButton) {
            dateButton.classList.toggle("is-selected", dateButton === anchor);
        });

        title.textContent = appointment.title || "Appointment";
        reason.textContent = appointment.reason || appointment.pet || "Clinic appointment";
        date.textContent = formatDate(appointment.date);
        time.textContent = formatTime(appointment.time) + " - " + (appointment.status || "Scheduled");
        placePopover(anchor);
    }

    function renderCalendar() {
        if (!calendarDays || !calendarMonth || !calendarYear) return;

        hidePopover();

        const monthDate = new Date(visibleYear, visibleMonth, 1);
        const monthName = monthDate.toLocaleDateString(undefined, { month: "long" });
        const startOffset = (monthDate.getDay() + 6) % 7;
        const daysInVisibleMonth = new Date(visibleYear, visibleMonth + 1, 0).getDate();

        calendarMonth.textContent = monthName;
        calendarYear.textContent = visibleYear;
        calendarDays.innerHTML = "";

        for (let i = 0; i < startOffset; i += 1) {
            const emptyDay = document.createElement("span");
            emptyDay.className = "muted";
            calendarDays.appendChild(emptyDay);
        }

        for (let day = 1; day <= daysInVisibleMonth; day += 1) {
            const dateKey = toDateKey(visibleYear, visibleMonth, day);
            const hasAppointment = appointments.some(function (item) { return item.date === dateKey; });
            const isToday = visibleYear === todayInfo.year && visibleMonth === todayInfo.month && day === todayInfo.day;
            const dayElement = document.createElement(hasAppointment ? "button" : "span");

            dayElement.textContent = day;
            dayElement.className = [isToday ? "today" : "", hasAppointment ? "has-appointment" : ""]
                .filter(Boolean)
                .join(" ");

            if (hasAppointment) {
                dayElement.type = "button";
                dayElement.dataset.appointmentDate = dateKey;
                dayElement.setAttribute("aria-label", "View appointments on " + monthName + " " + day + ", " + visibleYear);
            }

            calendarDays.appendChild(dayElement);
        }
    }

    if (calendarDays) {
        calendarDays.addEventListener("click", function (event) {
            const appointmentButton = event.target.closest("[data-appointment-date]");
            if (!appointmentButton) return;

            showAppointment(appointmentButton);
        });
    }

    if (calendarPrev) {
        calendarPrev.addEventListener("click", function () {
            visibleMonth -= 1;
            if (visibleMonth < 0) {
                visibleMonth = 11;
                visibleYear -= 1;
            }
            renderCalendar();
        });
    }

    if (calendarNext) {
        calendarNext.addEventListener("click", function () {
            visibleMonth += 1;
            if (visibleMonth > 11) {
                visibleMonth = 0;
                visibleYear += 1;
            }
            renderCalendar();
        });
    }

    if (closeButton && popover) {
        closeButton.addEventListener("click", function () {
            hidePopover();
        });
    }

    renderCalendar();

    const search = document.getElementById("dashboardSearch");
    const searchableItems = Array.from(document.querySelectorAll("[data-dashboard-item]"));
    if (search) {
        search.addEventListener("input", function () {
            const query = search.value.trim().toLowerCase();
            searchableItems.forEach(function (item) {
                item.classList.toggle("is-filtered-out", query.length > 0 && !item.dataset.dashboardItem.includes(query));
            });
        });
    }

});
</script>
}


