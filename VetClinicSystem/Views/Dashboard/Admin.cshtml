@{
    ViewData["Title"] = "Admin Dashboard";
    var users = ViewBag.Users as List<VetClinicSystem.Models.User> ?? new List<VetClinicSystem.Models.User>();
}

<h2 class="mb-4">Admin Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5>Total Pets</h5>
                <h2>@ViewBag.TotalPets</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5>Total Appointments</h5>
                <h2>@ViewBag.TotalAppointments</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-dark bg-warning mb-3">
            <div class="card-body">
                <h5>Total Users</h5>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5>Unread Notifications</h5>
                <h2>@ViewBag.UnreadNotifications</h2>
            </div>
        </div>
    </div>
</div>

<hr />

<section class="admin-users-panel">
    <div class="admin-users-panel__header">
        <div>
            <h4>Users</h4>
            <p>All registered admin, staff, and client accounts.</p>
        </div>
        <span>@users.Count account@(users.Count == 1 ? "" : "s")</span>
    </div>

    @if (!users.Any())
    {
        <div class="alert alert-info">No users found.</div>
    }
    else
    {
        <div class="table-panel">
            <table class="table table-bordered table-striped admin-users-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Date Created</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in users)
                {
                    var displayName = user.PetOwner != null
                        ? $"{user.PetOwner.FirstName} {user.PetOwner.LastName}".Trim()
                        : user.Username;

                    <tr>
                        <td>@displayName</td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@(user.Role?.RoleName ?? "User")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="status-pill status-pill--success">Active</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--muted">Inactive</span>
                            }
                        </td>
                        <td>@user.DateCreated.ToString("MMM d, yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<hr />

<h4>Appointments Overview</h4>

<section class="chart-card chart-card--appointments">
    <canvas id="appointmentsChart"></canvas>
</section>

@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            var labels = @Html.Raw(ViewBag.ChartLabels);
            var data = @Html.Raw(ViewBag.ChartData);

            var ctx = document.getElementById('appointmentsChart').getContext('2d');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Appointments per Day',
                        data: data,
                        borderWidth: 2,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true
                        }
                    }
                }
            });
        </script>
}
