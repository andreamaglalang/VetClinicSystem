@{
    var notificationCount = Context.Items["NotificationCount"] ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetClinicSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Account" asp-action="Login">VetClinicSystem</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            var roleId = Context.Session.GetInt32("RoleId");

                            if (roleId == 1)
                            {
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Admin">Dashboard</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Pets" asp-action="Index">Pets</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">Appointments</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Services" asp-action="Index">Services</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Clinic" asp-action="Index">Clinic</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index">
                                                Notifications (@notificationCount)
                                            </a>
                                        </li>
                            }

                            if (roleId == 2)
                            {
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Staff">Dashboard</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">Appointments</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index">
                                                Notifications (@notificationCount)
                                            </a>
                                        </li>
                            }

                            if (roleId == 3)
                            {
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Client">Dashboard</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Pets" asp-action="Index">My Pets</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">My Appointments</a>
                                        </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.GetInt32("UserId") == null)
                        {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                                </li>
                        }
                        else
                        {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">Hello, @Context.Session.GetString("Username")</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                                </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>