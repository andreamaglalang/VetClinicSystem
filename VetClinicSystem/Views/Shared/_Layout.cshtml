@{
    var username = Context.Session.GetString("Username");
    var roleId = Context.Session.GetInt32("RoleId");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isClientDashboard = currentController == "Dashboard" && currentAction == "Client";
    var hasPopupMessage = TempData["Success"] != null || TempData["Error"] != null || TempData["Warning"] != null || TempData["Message"] != null || ViewBag.Error != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetClinicSystem</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="medivet-side-circles" aria-hidden="true">
        <span class="medivet-side-circle medivet-side-circle-blue"></span>
        <span class="medivet-side-circle medivet-side-circle-yellow"></span>
    </div>

    @if (hasPopupMessage)
    {
    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] != null)
        {
            <div class="vet-toast vet-toast--success" role="status">
                <button class="vet-toast-close" type="button" aria-label="Close notification"><i class="fa-solid fa-xmark"></i></button>
                <i class="fa-solid fa-check"></i>
                <strong>Success!</strong>
                <span>@TempData["Success"]</span>
                <button class="vet-toast-action" type="button">Continue</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="vet-toast vet-toast--error" role="alert">
                <button class="vet-toast-close" type="button" aria-label="Close notification"><i class="fa-solid fa-xmark"></i></button>
                <i class="fa-solid fa-xmark"></i>
                <strong>Error occurred!</strong>
                <span>@TempData["Error"]</span>
                <button class="vet-toast-action" type="button">OK</button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="vet-toast vet-toast--warning" role="status">
                <button class="vet-toast-close" type="button" aria-label="Close notification"><i class="fa-solid fa-xmark"></i></button>
                <i class="fa-solid fa-exclamation"></i>
                <strong>Something went wrong!</strong>
                <span>@TempData["Warning"]</span>
                <button class="vet-toast-action" type="button">Try again</button>
            </div>
        }
        @if (TempData["Message"] != null)
        {
            <div class="vet-toast vet-toast--info" role="status">
                <button class="vet-toast-close" type="button" aria-label="Close notification"><i class="fa-solid fa-xmark"></i></button>
                <i class="fa-solid fa-info"></i>
                <strong>Notice</strong>
                <span>@TempData["Message"]</span>
                <button class="vet-toast-action" type="button">OK</button>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="vet-toast vet-toast--error" role="alert">
                <button class="vet-toast-close" type="button" aria-label="Close notification"><i class="fa-solid fa-xmark"></i></button>
                <i class="fa-solid fa-xmark"></i>
                <strong>Error occurred!</strong>
                <span>@ViewBag.Error</span>
                <button class="vet-toast-action" type="button">OK</button>
            </div>
        }
    </div>
    }

    <header class="main-header @(roleId == null ? "main-header--public" : "main-header--account")">
        <div class="top-clinic-bar">
            <a class="top-logo" asp-controller="Home" asp-action="Index" aria-label="Go to Thrive home page">
                <span class="brand-icon">
                    <img src="~/images/site/thrive-logo.png" asp-append-version="true" alt="Thrive Animal Specialist and Grooming Hub logo" />
                </span>
                <div>
                    <strong>Thrive</strong>
                    <small>Animal Specialist & Grooming Hub</small>
                </div>
            </a>

            @if (roleId == null)
            {
                <div class="top-header-actions">
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            }
            else
            {
                <div class="top-header-actions">
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            }
        </div>

        <button class="mobile-nav-toggle" type="button" aria-controls="mainNavigation" aria-expanded="false">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
            <span>Menu</span>
        </button>

        <nav class="main-landing-nav @(roleId == null ? "main-landing-nav--public" : "main-landing-nav--account")" id="mainNavigation">
            @if (roleId == 1)
            {
                    <a asp-controller="Dashboard" asp-action="Admin">Dashboard</a>
                    <a asp-controller="Dashboard" asp-action="Users">Users</a>
                    <a asp-controller="Pets" asp-action="Index">Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Services" asp-action="Index">Services</a>
                    <a asp-controller="Clinic" asp-action="Index">Clinic</a>
                    <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                    <a asp-controller="Account" asp-action="Settings">Account Settings</a>
            }
            else if (roleId == 2)
            {
                    <a asp-controller="Dashboard" asp-action="Staff">Dashboard</a>
                    <a asp-controller="Pets" asp-action="Index">Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Services" asp-action="Index">Services</a>
                    <a asp-controller="Clinic" asp-action="Index">Clinic</a>
                    <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                    <a asp-controller="Account" asp-action="Settings">Account Settings</a>
            }
            else if (roleId == 3)
            {
                    <a asp-controller="Dashboard" asp-action="Client">Dashboard</a>
                    <a asp-controller="Pets" asp-action="Index">My Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">My Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Clinic" asp-action="Index">Clinic</a>
                    <a asp-controller="Account" asp-action="Settings">Account Settings</a>
            }
            else
            {
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a>
                    <a href="/#prices">Prices</a>
                    <a asp-controller="Appointments" asp-action="GuestCreate">Book Surgery</a>
                    <a href="/#articles">Articles</a>
                    <a href="/#contact">Contact</a>
            }
            @if (roleId != null)
            {
                    <a class="mobile-menu-logout" asp-controller="Account" asp-action="Logout">Logout</a>
            }
        </nav>
    </header>

    <main class="page-shell">
    @if (roleId == null)
    {
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="app-container @(isClientDashboard ? "app-container--client-dashboard" : "app-container--standard")">
            @RenderBody()
        </div>
    }
</main>

    <footer class="vet-footer">
        <div class="container-fluid text-center">
            <p>© 2026 VetClinicSystem. Caring for pets with comfort and compassion.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".vet-toast").forEach(function (toast) {
                const dismiss = function () {
                    toast.classList.add("is-hiding");
                    window.setTimeout(function () {
                        const stack = toast.closest(".toast-stack");
                        toast.remove();
                        if (stack && !stack.querySelector(".vet-toast")) {
                            stack.remove();
                        }
                    }, 220);
                };

                toast.querySelectorAll("button").forEach(function (button) {
                    button.addEventListener("click", dismiss);
                });
            });

            document.querySelectorAll(".toast-stack").forEach(function (stack) {
                stack.addEventListener("click", function (event) {
                    if (event.target === stack) {
                        const toast = stack.querySelector(".vet-toast");
                        if (toast) {
                            toast.querySelector("button")?.click();
                        }
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
