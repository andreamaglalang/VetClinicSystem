@{
    var username = Context.Session.GetString("Username");
    var roleId = Context.Session.GetInt32("RoleId");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetClinicSystem</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="main-header">
        <div class="top-clinic-bar d-flex justify-content-between align-items-center">
            <div class="top-logo">
                <span class="brand-icon"></span>
                <div>
                    <strong>Thrive</strong>
                    <small>Animal Specialist & Grooming Hub</small>
                </div>
            </div>

            

            <div class="top-socials">
                <a href="https://www.facebook.com/share/1KmWxCrZmF/" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="mailto:thriveanimalspecialist@gmail.com"><i class="fa-solid fa-envelope"></i></a>
                <a href="https://maps.app.goo.gl/Kht4unZvM7oVFW25A?g_st=ac" target="_blank"><i class="fa-solid fa-map-location-dot"></i></a>
            </div>
        </div>

        <nav class="main-landing-nav">
            @if (roleId == 1)
            {
                    <a asp-controller="Dashboard" asp-action="Admin">Dashboard</a>
                    <a asp-controller="Pets" asp-action="Index">Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Services" asp-action="Index">Services</a>
                    <a asp-controller="Clinic" asp-action="Index">Clinic</a>
                    <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
            }
            else if (roleId == 2)
            {
                    <a asp-controller="Dashboard" asp-action="Staff">Dashboard</a>
                    <a asp-controller="Pets" asp-action="Index">Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Services" asp-action="Index">Services</a>
                    <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
            }
            else if (roleId == 3)
            {
                    <a asp-controller="Dashboard" asp-action="Client">Dashboard</a>
                    <a asp-controller="Pets" asp-action="Index">My Pets</a>
                    <a asp-controller="Appointments" asp-action="Index">My Appointments</a>
                    <a asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                    <a asp-controller="Vaccinations" asp-action="Index">Vaccinations</a>
                    <a asp-controller="Clinic" asp-action="Index">Clinic</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
            }
            else
            {
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a href="/#services">Services</a>
                    <a href="/#gallery">Gallery</a>
                    <a href="/#contact">Contact</a>
                    <a asp-controller="Account" asp-action="Login">Login</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </nav>
    </header>

    <main class="page-shell">
    @if (roleId == null)
    {
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="app-container">
            @RenderBody()
        </div>
    }
</main>

    <footer class="vet-footer">
        <div class="container-fluid text-center">
            <p>© 2026 VetClinicSystem. Caring for pets with comfort and compassion.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>