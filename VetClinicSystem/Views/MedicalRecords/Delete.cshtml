@model VetClinicSystem.Models.MedicalRecord

<h2>Delete Medical Record</h2>

<table class="table table-bordered">
    <tr><th>Diagnosis</th><td>@Model.Diagnosis</td></tr>
</table>

<form method="post" data-confirm-message="Are you sure you want to delete this medical record?">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
