@model IEnumerable<VetClinicSystem.Models.MedicalRecord>
@{
    var roleId = Context.Session.GetInt32("RoleId");
    var canManageMedicalRecords = roleId == 1 || roleId == 2;
}

<h2>Medical Records</h2>

@if (canManageMedicalRecords)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Record</a>
    </p>
}

<table class="table table-bordered table-medical-records">
    <thead>
        <tr>
            <th>Pet</th>
            @if (canManageMedicalRecords)
            {
                <th>Owner Name</th>
            }
            <th>Diagnosis</th>
            <th>Treatment</th>
            <th>Appointment</th>
            <th>Record Date</th>
            @if (canManageMedicalRecords)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var ownerName = item.Pet?.Owner == null
                ? "N/A"
                : string.IsNullOrWhiteSpace($"{item.Pet.Owner.FirstName} {item.Pet.Owner.LastName}".Trim())
                    ? "N/A"
                    : $"{item.Pet.Owner.FirstName} {item.Pet.Owner.LastName}".Trim();
            <tr>
                <td>@item.Pet?.PetName</td>
                @if (canManageMedicalRecords)
                {
                    <td>@ownerName</td>
                }
                <td>@item.Diagnosis</td>
                <td>@item.Treatment</td>
                <td>@(item.Appointment?.Service?.ServiceName ?? "Walk-in / record only")</td>
                <td>@item.RecordDate.ToString("MMM d, yyyy")</td>
                @if (canManageMedicalRecords)
                {
                    <td>
                        <div class="table-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="table-action-icon table-action-icon--details" title="Details" aria-label="View medical record details">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="table-action-icon table-action-icon--edit" title="Edit" aria-label="Edit medical record">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="table-action-icon table-action-icon--delete" title="Delete" aria-label="Delete medical record">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
