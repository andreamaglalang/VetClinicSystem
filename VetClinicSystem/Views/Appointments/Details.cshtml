@model VetClinicSystem.Models.Appointment

<h2>Appointment Details</h2>

<table class="table table-bordered">
    <tr><th>Pet</th><td>@Model.Pet?.PetName</td></tr>
    <tr><th>Service</th><td>@Model.Service?.ServiceName</td></tr>
    <tr><th>Current Schedule</th><td>@Model.AppointmentDate.ToString("MMMM d, yyyy") @Model.AppointmentTime.ToString("h:mm tt")</td></tr>
    <tr><th>Preferred Schedule</th><td>@((Model.PreferredAppointmentDate ?? Model.AppointmentDate).ToString("MMMM d, yyyy")) @((Model.PreferredAppointmentTime ?? Model.AppointmentTime).ToString("h:mm tt"))</td></tr>
    <tr><th>Surgery Category</th><td>@(Model.SurgeryCategory ?? "Not set")</td></tr>
    <tr><th>Emergency Priority</th><td>@(Model.IsEmergency ? "Yes" : "No")</td></tr>
    <tr><th>Schedule Finalized</th><td>@(Model.IsScheduleFinalized ? "Yes" : "Pending clinic finalization")</td></tr>
    <tr><th>Status</th><td>@Model.Status?.StatusName</td></tr>
    <tr><th>Reason</th><td>@Model.ReasonForVisit</td></tr>
    <tr><th>Booking Type</th><td>@(Model.IsGuestBooking ? "Guest" : "Client")</td></tr>
    <tr><th>Client Notes</th><td>@Model.ClientNotes</td></tr>
    <tr><th>Staff Notes</th><td>@(string.IsNullOrWhiteSpace(Model.StaffNotes) ? "-" : Model.StaffNotes)</td></tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
