@model VetClinicSystem.Models.Appointment

@{
    var roleId = Context.Session.GetInt32("RoleId");
    var isClient = roleId == 3;
    var preferredDate = Model.PreferredAppointmentDate ?? Model.AppointmentDate;
    var preferredTime = Model.PreferredAppointmentTime ?? Model.AppointmentTime;
    var minScheduleDate = DateOnly.FromDateTime(DateTime.Today);
    var maxScheduleDate = minScheduleDate.AddDays(6);
    var minScheduleDateValue = minScheduleDate.ToString("yyyy-MM-dd");
    var maxScheduleDateValue = maxScheduleDate.ToString("yyyy-MM-dd");
    var allowedScheduleRangeMessage = $"Surgery requests must be scheduled between {minScheduleDate:MMMM d, yyyy} and {maxScheduleDate:MMMM d, yyyy}.";
    var appointmentDateValue = ViewData.ModelState.TryGetValue(nameof(Model.AppointmentDate), out var appointmentDateEntry) &&
        !string.IsNullOrWhiteSpace(appointmentDateEntry.AttemptedValue)
        ? appointmentDateEntry.AttemptedValue
        : Model.AppointmentDate == default
            ? string.Empty
            : Model.AppointmentDate.ToString("yyyy-MM-dd");
    var appointmentTimeValue = ViewData.ModelState.TryGetValue(nameof(Model.AppointmentTime), out var appointmentTimeEntry) &&
        !string.IsNullOrWhiteSpace(appointmentTimeEntry.AttemptedValue)
        ? appointmentTimeEntry.AttemptedValue
        : Model.AppointmentTime != default
            ? Model.AppointmentTime.ToString("HH\\:mm")
            : string.Empty;
}

<h2>@(isClient ? "Update Surgery Request" : "Manage Surgery Schedule")</h2>

<div class="appointment-create-notes" aria-label="Surgery scheduling reminders">
    @if (isClient)
    {
        <section>
            <i class="fa-solid fa-calendar-check"></i>
            <div>
                <strong>Preferred schedule request</strong>
                <p>You can update your preferred surgery date and time, but the clinic still reviews availability, complexity, and final schedule confirmation.</p>
            </div>
        </section>
        <section>
            <i class="fa-solid fa-scale-balanced"></i>
            <div>
                <strong>Surgery load planning</strong>
                <p>Minor surgeries use 1 point, moderate use 2, major use 3, and regular scheduling allows up to 5 points per day. Emergency cases can bypass daily capacity.</p>
            </div>
        </section>
    }
    else
    {
        <section>
            <i class="fa-solid fa-user-clock"></i>
            <div>
                <strong>Client preferred schedule</strong>
                <p>@preferredDate.ToString("MMMM d, yyyy") at @preferredTime.ToString("h:mm tt")</p>
            </div>
        </section>
        <section>
            <i class="fa-solid fa-clipboard-check"></i>
            <div>
                <strong>Schedule control</strong>
                <p>Adjust the final surgery date, time, status, and finalization after reviewing complexity, emergency priority, and the clinic's daily load.</p>
            </div>
        </section>
    }
</div>

<form asp-action="Edit" asp-controller="Appointments" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="PetId"></label>
        <select asp-for="PetId" asp-items="ViewBag.Pets" class="form-control"></select>
        <span asp-validation-for="PetId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceId">Surgery Service</label>
        <select asp-for="ServiceId" asp-items="ViewBag.Services" class="form-control"></select>
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="AppointmentDate">@(isClient ? "Preferred Surgery Date" : "Final Surgery Date")</label>
            <input id="AppointmentDate" name="AppointmentDate" value="@appointmentDateValue" type="date" lang="en-US" class="form-control" data-appointment-date data-min-date="@minScheduleDateValue" data-max-date="@maxScheduleDateValue" data-range-message="@allowedScheduleRangeMessage" />
            <span class="text-danger" data-unavailable-date-message></span>
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="AppointmentTime">@(isClient ? "Preferred Surgery Time" : "Final Surgery Time")</label>
            <select id="AppointmentTime" name="AppointmentTime" class="form-control" data-appointment-time data-selected-time="@appointmentTimeValue" required>
                <option value="">Select time slot</option>
            </select>
            <span class="form-text text-muted">Monday: 9:00 AM-5:00 PM | Wednesday-Sunday: 9:00 AM-7:00 PM</span>
            <span class="text-danger" data-clinic-time-message></span>
            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="SurgeryCategory">Surgery Category</label>
            <select asp-for="SurgeryCategory" asp-items="ViewBag.SurgeryCategories" class="form-control">
                <option value="">Select category</option>
            </select>
            <span asp-validation-for="SurgeryCategory" class="text-danger"></span>
        </div>
    </div>

    <div class="appointment-emergency-toggle mt-3 mb-3">
        <div class="appointment-emergency-toggle__copy">
            <label asp-for="IsEmergency" class="form-check-label">Mark this surgery request as emergency priority</label>
            <p class="appointment-emergency-toggle__hint">Emergency cases can bypass the usual daily surgery load when the clinic confirms urgent care is needed.</p>
        </div>
        <div class="appointment-emergency-toggle__switch">
            <input asp-for="IsEmergency" class="form-check-input" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ReasonForVisit"></label>
        <input asp-for="ReasonForVisit" class="form-control" maxlength="255" />
        <span asp-validation-for="ReasonForVisit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClientNotes">Notes</label>
        <textarea asp-for="ClientNotes" class="form-control" maxlength="255"></textarea>
        <span asp-validation-for="ClientNotes" class="text-danger"></span>
    </div>

    @if (!isClient)
    {
        <div class="mb-3">
            <label asp-for="StaffNotes">Staff Notes</label>
            <textarea asp-for="StaffNotes" class="form-control" maxlength="255"></textarea>
            <span asp-validation-for="StaffNotes" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="StatusId">Appointment Status</label>
                <select asp-for="StatusId" asp-items="ViewBag.EditStatuses" class="form-control"></select>
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input asp-for="IsScheduleFinalized" class="form-check-input" />
                    <label asp-for="IsScheduleFinalized" class="form-check-label">Finalize this surgery schedule</label>
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-success">@(isClient ? "Update Surgery Request" : "Save Schedule Changes")</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
