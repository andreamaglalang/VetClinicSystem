@model VetClinicSystem.Models.Appointment

<h2>Edit Appointment</h2>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="PetId"></label>
        <select asp-for="PetId" asp-items="ViewBag.Pets" class="form-control"></select>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceId"></label>
        <select asp-for="ServiceId" asp-items="ViewBag.Services" class="form-control"></select>
    </div>

    <div class="mb-3">
        <label asp-for="AppointmentDate"></label>
        <input asp-for="AppointmentDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AppointmentTime"></label>
        <input asp-for="AppointmentTime" type="time" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ReasonForVisit"></label>
        <input asp-for="ReasonForVisit" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ClientNotes"></label>
        <textarea asp-for="ClientNotes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>