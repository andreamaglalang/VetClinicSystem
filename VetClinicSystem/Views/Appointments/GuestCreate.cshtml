@model VetClinicSystem.Models.GuestAppointmentBooking

@{
    ViewData["Title"] = "Guest Surgery Booking";
    var minScheduleDate = DateOnly.FromDateTime(DateTime.Today);
    var maxScheduleDate = minScheduleDate.AddDays(6);
    var minScheduleDateValue = minScheduleDate.ToString("yyyy-MM-dd");
    var maxScheduleDateValue = maxScheduleDate.ToString("yyyy-MM-dd");
    var allowedScheduleRangeMessage = $"Surgery requests must be scheduled between {minScheduleDate:MMMM d, yyyy} and {maxScheduleDate:MMMM d, yyyy}.";
    var appointmentDateValue = Model.AppointmentDate?.ToString("yyyy-MM-dd") ?? string.Empty;
}

<section class="guest-booking-shell">
    <div class="guest-booking-container">
        <div class="guest-booking-heading">
            <span>Surgery appointment</span>
            <h2>Guest Surgery Booking</h2>
            <p>Share your contact and pet details so the clinic can confirm the surgery schedule with you.</p>
        </div>

        <form method="post" class="guest-booking-card">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="guest-booking-notes">
                <div>
                    <span><i class="fa-solid fa-calendar-check"></i></span>
                    <div>
                        <strong>Surgery request only</strong>
                        <p>Surgery is the only service available for appointment booking. Guests submit a preferred schedule and the clinic finalizes the actual surgery slot after review.</p>
                    </div>
                </div>
                <div>
                    <span><i class="fa-solid fa-vial-circle-check"></i></span>
                    <div>
                        <strong>Pre-surgery reminder</strong>
                        <p>Pre-op blood test screening is walk-in only. If your pet is fit, schedule the procedure within 1 week.</p>
                    </div>
                </div>
                <div>
                    <span><i class="fa-solid fa-clipboard-list"></i></span>
                    <div>
                        <strong>Preparation notes</strong>
                        <p>Bathe your pet at least a day before surgery. Withhold food for 8-12 hours and water for 5 hours.</p>
                    </div>
                </div>
            </div>

            <div class="guest-form-section">
                <h3>Owner Information</h3>
                <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber"></label>
                        <input asp-for="ContactNumber" class="form-control" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="14" pattern="09[0-9\s-]{9,12}" title="Enter an 11-digit mobile number starting with 09." />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" class="form-control" maxlength="255" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="guest-form-section">
                <h3>Pet Information</h3>
                <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PetName"></label>
                    <input asp-for="PetName" class="form-control" />
                    <span asp-validation-for="PetName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Species"></label>
                    <input asp-for="Species" class="form-control" maxlength="50" pattern="[A-Za-z][A-Za-z\s'\-]*" title="Species must contain letters only and may include spaces, apostrophes, or hyphens." />
                    <span asp-validation-for="Species" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Breed"></label>
                    <input asp-for="Breed" class="form-control" maxlength="100" pattern="[A-Za-z][A-Za-z\s'\-]*" title="Breed must contain letters only and may include spaces, apostrophes, or hyphens." />
                    <span asp-validation-for="Breed" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sex"></label>
                    <select asp-for="Sex" asp-items="ViewBag.SexOptions" class="form-control">
                        <option value="">Select sex</option>
                    </select>
                    <span asp-validation-for="Sex" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Age"></label>
                    <input asp-for="Age" type="number" min="0" max="40" step="1" class="form-control" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Weight">Weight (kg)</label>
                    <input asp-for="Weight" type="number" min="0.10" max="200.00" step="0.01" class="form-control" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="PetNotes"></label>
                    <textarea asp-for="PetNotes" class="form-control" maxlength="255"></textarea>
                    <span asp-validation-for="PetNotes" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="guest-form-section">
                <h3>Surgery Appointment</h3>
                <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ServiceId"></label>
                    <select asp-for="ServiceId" asp-items="ViewBag.Services" class="form-control"></select>
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AppointmentDate">Preferred Surgery Date</label>
                    <input id="AppointmentDate" name="AppointmentDate" value="@appointmentDateValue" type="date" lang="en-US" class="form-control" data-appointment-date data-min-date="@minScheduleDateValue" data-max-date="@maxScheduleDateValue" data-range-message="@allowedScheduleRangeMessage" />
                    <span class="text-danger" data-unavailable-date-message></span>
                    <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AppointmentTime">Preferred Surgery Time</label>
                    <input asp-for="AppointmentTime" type="time" class="form-control" data-appointment-time />
                    <span class="form-text text-muted">Monday: 9:00 AM-5:00 PM | Wednesday-Sunday: 9:00 AM-7:00 PM</span>
                    <span class="text-danger" data-clinic-time-message></span>
                    <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SurgeryCategory"></label>
                    <select asp-for="SurgeryCategory" asp-items="ViewBag.SurgeryCategories" class="form-control">
                        <option value="">Select category</option>
                    </select>
                    <span asp-validation-for="SurgeryCategory" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="appointment-emergency-toggle appointment-emergency-toggle--guest">
                        <div class="appointment-emergency-toggle__copy">
                            <label asp-for="IsEmergency" class="form-check-label">Mark this surgery request as emergency priority</label>
                            <p class="appointment-emergency-toggle__hint">Emergency cases can bypass the usual daily surgery load when the clinic confirms urgent care is needed.</p>
                        </div>
                        <div class="appointment-emergency-toggle__switch">
                            <input asp-for="IsEmergency" class="form-check-input" />
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReasonForVisit"></label>
                    <input asp-for="ReasonForVisit" class="form-control" maxlength="255" />
                    <span asp-validation-for="ReasonForVisit" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ClientNotes"></label>
                    <textarea asp-for="ClientNotes" class="form-control" maxlength="255"></textarea>
                    <span asp-validation-for="ClientNotes" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="guest-booking-actions">
                <button type="submit" class="btn btn-success">Submit Guest Booking</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dateInput = document.querySelector("[data-appointment-date]");
            const timeInput = document.querySelector("[data-appointment-time]");
            const message = document.querySelector("[data-unavailable-date-message]");
            const timeMessage = document.querySelector("[data-clinic-time-message]");
            const form = dateInput?.closest("form");
            const rangeMessage = dateInput?.dataset.rangeMessage || "";
            const minDateValue = dateInput?.dataset.minDate || "";
            const maxDateValue = dateInput?.dataset.maxDate || "";

            if (!dateInput || !timeInput || !message || !timeMessage || !form) return;

            dateInput.addEventListener("keydown", function (event) {
                if (event.ctrlKey || event.metaKey || event.altKey) return;

                const allowedKeys = [
                    "Tab",
                    "Shift",
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowUp",
                    "ArrowDown",
                    "Home",
                    "End",
                    "Escape"
                ];

                if (allowedKeys.includes(event.key)) return;

                if (typeof dateInput.showPicker === "function") {
                    dateInput.showPicker();
                }

                event.preventDefault();
            });

            function getEasterSunday(year) {
                const a = year % 19;
                const b = Math.floor(year / 100);
                const c = year % 100;
                const d = Math.floor(b / 4);
                const e = b % 4;
                const f = Math.floor((b + 8) / 25);
                const g = Math.floor((b - f + 1) / 3);
                const h = (19 * a + b - d - g + 15) % 30;
                const i = Math.floor(c / 4);
                const k = c % 4;
                const l = (32 + 2 * e + 2 * i - h - k) % 7;
                const m = Math.floor((a + 11 * h + 22 * l) / 451);
                const month = Math.floor((h + l - 7 * m + 114) / 31);
                const day = ((h + l - 7 * m + 114) % 31) + 1;

                return new Date(year, month - 1, day);
            }

            function toKey(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");
                return year + "-" + month + "-" + day;
            }

            function addDays(date, days) {
                const next = new Date(date);
                next.setDate(next.getDate() + days);
                return next;
            }

            function getUnavailableDateMessage(value) {
                if (!value) return "";

                const selectedDate = new Date(value + "T00:00:00");
                const minDate = minDateValue ? new Date(minDateValue + "T00:00:00") : null;
                const maxDate = maxDateValue ? new Date(maxDateValue + "T00:00:00") : null;
                const month = selectedDate.getMonth() + 1;
                const day = selectedDate.getDate();

                if ((minDate && selectedDate < minDate) || (maxDate && selectedDate > maxDate)) {
                    return rangeMessage;
                }

                if (selectedDate.getDay() === 2) {
                    return "The clinic is closed every Tuesday. Please choose another date.";
                }

                const fixedHolidays = {
                    "1-1": "New Year's Day",
                    "11-1": "All Saints' Day",
                    "12-24": "Christmas Eve",
                    "12-25": "Christmas Day",
                    "12-31": "New Year's Eve"
                };

                const fixedHoliday = fixedHolidays[month + "-" + day];
                if (fixedHoliday) {
                    return "The clinic is unavailable on " + fixedHoliday + ". Please choose another date.";
                }

                const easterSunday = getEasterSunday(selectedDate.getFullYear());
                const holyWeekDates = {};
                holyWeekDates[toKey(addDays(easterSunday, -3))] = "Maundy Thursday";
                holyWeekDates[toKey(addDays(easterSunday, -2))] = "Good Friday";
                holyWeekDates[toKey(addDays(easterSunday, -1))] = "Black Saturday";

                const holyWeekName = holyWeekDates[value];
                if (holyWeekName) {
                    return "The clinic is unavailable on " + holyWeekName + ". Please choose another date.";
                }

                return "";
            }

            function validateDate() {
                const error = getUnavailableDateMessage(dateInput.value);
                message.textContent = error;
                dateInput.setCustomValidity(error);
                return error === "";
            }

            function getClinicHoursMessage(value) {
                if (!value || !timeInput.value) return "";

                const selectedDate = new Date(value + "T00:00:00");
                const day = selectedDate.getDay();
                const selectedTime = timeInput.value;

                if (day === 1 && (selectedTime < "09:00" || selectedTime > "17:00")) {
                    return "Preferred surgery time must be within clinic hours for Monday: 9:00 AM to 5:00 PM.";
                }

                if ([3, 4, 5, 6, 0].includes(day) && (selectedTime < "09:00" || selectedTime > "19:00")) {
                    return "Preferred surgery time must be within clinic hours for this day: 9:00 AM to 7:00 PM.";
                }

                return "";
            }

            function validateTime() {
                const error = getClinicHoursMessage(dateInput.value);
                timeMessage.textContent = error;
                timeInput.setCustomValidity(error);
                return error === "";
            }

            dateInput.addEventListener("change", validateDate);
            dateInput.addEventListener("change", validateTime);
            timeInput.addEventListener("change", validateTime);
            form.addEventListener("submit", function (event) {
                const isDateValid = validateDate();
                const isTimeValid = validateTime();

                if (!isDateValid || !isTimeValid) {
                    event.preventDefault();
                    if (!isDateValid) {
                        dateInput.reportValidity();
                    } else {
                        timeInput.reportValidity();
                    }
                }
            });

            validateDate();
            validateTime();
        });
    </script>
}
