@model VetClinicSystem.Models.Pet

@{
    ViewData["Title"] = "Edit Pet";
}

<h2>Edit Pet</h2>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Edit" asp-controller="Pets" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="OwnerId" />

    <div class="mb-3">
        <label asp-for="PetName"></label>
        <input asp-for="PetName" class="form-control" maxlength="100" pattern="[A-Za-z]+(?:\s[A-Za-z]+)*" title="Pet name must contain letters and spaces only." data-letters-only="true" />
        <span asp-validation-for="PetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Species"></label>
        <input asp-for="Species" class="form-control" maxlength="50" pattern="[A-Za-z]+(?:\s[A-Za-z]+)*" title="Species must contain letters and spaces only." data-letters-only="true" />
        <span asp-validation-for="Species" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Breed"></label>
        <input asp-for="Breed" class="form-control" maxlength="100" pattern="[A-Za-z]+(?:\s[A-Za-z]+)*" title="Breed must contain letters and spaces only." data-letters-only="true" />
        <span asp-validation-for="Breed" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Sex" class="form-label"></label>
        <select asp-for="Sex" class="form-control">
            <option value="">-- Select Sex --</option>
            @foreach (var sex in ViewBag.SexOptions)
            {
                <option value="@sex">@sex</option>
            }
        </select>
        <span asp-validation-for="Sex" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" min="0" max="40" step="1" class="form-control" inputmode="numeric" data-integer-only="true" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color"></label>
        <input asp-for="Color" class="form-control" maxlength="50" pattern="[A-Za-z]+(?:\s[A-Za-z]+)*(?:,\s?[A-Za-z]+(?:\s[A-Za-z]+)*)*" title="Color may contain letters, spaces, and commas only." data-color-only="true" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Weight">Weight (kg)</label>
        <input asp-for="Weight" type="text" inputmode="decimal" class="form-control" maxlength="6" pattern="^\d+(\.\d{1,2})?$" title="Weight must be a valid number with up to 2 decimal places." data-decimal-only="true" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" class="form-control" maxlength="255"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.setupInputSanitizers) {
                    window.setupInputSanitizers(document);
                }
            });
        </script>
}
