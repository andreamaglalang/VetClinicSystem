@model VetClinicSystem.Models.Pet

<h2>Delete Pet</h2>

<div class="alert alert-danger">Are you sure you want to delete this pet?</div>

<table class="table table-bordered">
    <tr><th>Pet Name</th><td>@Model.PetName</td></tr>
    <tr><th>Species</th><td>@Model.Species</td></tr>
    <tr><th>Breed</th><td>@Model.Breed</td></tr>
</table>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>