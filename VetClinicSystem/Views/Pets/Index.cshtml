@model IEnumerable<VetClinicSystem.Models.Pet>

@{
    ViewData["Title"] = "Pets";
    var roleId = Context.Session.GetInt32("RoleId");
    var showOwnerColumn = roleId == 1 || roleId == 2;
}

<h2>Pets</h2>

<form method="get" asp-action="Index" class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@(showOwnerColumn ? "Search by pet name, owner, species, or breed" : "Search by pet name, species, or breed")" />
        </div>
        <div class="col-md-6">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Pet</a>
</p>

<table class="table table-bordered table-striped table-pets @(showOwnerColumn ? "table-pets--with-owner" : "table-pets--client")">
    <thead>
        <tr>
            <th>Pet Name</th>
            @if (showOwnerColumn)
            {
                <th>Owner Name</th>
            }
            <th>Species</th>
            <th>Breed</th>
            <th>Sex</th>
            <th>Age</th>
            <th>Weight</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pet in Model)
        {
            var ownerName = pet.Owner == null
                ? "N/A"
                : string.IsNullOrWhiteSpace($"{pet.Owner.FirstName} {pet.Owner.LastName}".Trim())
                    ? "N/A"
                    : $"{pet.Owner.FirstName} {pet.Owner.LastName}".Trim();

            <tr>
                <td>@pet.PetName</td>
                @if (showOwnerColumn)
                {
                    <td>@ownerName</td>
                }
                <td>@pet.Species</td>
                <td>@pet.Breed</td>
                <td>@pet.Sex</td>
                <td>@pet.Age</td>
                <td>@pet.Weight</td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Details" asp-route-id="@pet.Id" class="table-action-icon table-action-icon--details" title="Details" aria-label="View pet details">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@pet.Id" class="table-action-icon table-action-icon--edit" title="Edit" aria-label="Edit pet">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@pet.Id" class="table-action-icon table-action-icon--delete" title="Delete" aria-label="Delete pet">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
