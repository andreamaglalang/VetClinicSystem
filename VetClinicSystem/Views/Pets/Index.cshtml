@model IEnumerable<VetClinicSystem.Models.Pet>

@{
    ViewData["Title"] = "Pets";
}

<h2>Pets</h2>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
        <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Pet</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Pet Name</th>
            <th>Species</th>
            <th>Breed</th>
            <th>Sex</th>
            <th>Age</th>
            <th>Weight</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pet in Model)
        {
            <tr>
                <td>@pet.PetName</td>
                <td>@pet.Species</td>
                <td>@pet.Breed</td>
                <td>@pet.Sex</td>
                <td>@pet.Age</td>
                <td>@pet.Weight</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pet.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>