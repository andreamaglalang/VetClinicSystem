@model VetClinicSystem.Models.VaccinationRecord

<h2>Delete Vaccination</h2>

<table class="table table-bordered">
    <tr><th>Vaccine</th><td>@Model.VaccineName</td></tr>
</table>

<form asp-action="Delete" asp-controller="Vaccinations" method="post" data-confirm-message="Are you sure you want to delete this vaccination record?">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
