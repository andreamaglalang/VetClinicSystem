@model VetClinicSystem.Models.VaccinationRecord

<h2>Delete Vaccination</h2>

<div class="alert alert-danger">Are you sure you want to delete this vaccination record?</div>

<table class="table table-bordered">
    <tr><th>Vaccine</th><td>@Model.VaccineName</td></tr>
</table>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>