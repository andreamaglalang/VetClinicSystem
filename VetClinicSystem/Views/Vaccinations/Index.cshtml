@model IEnumerable<VetClinicSystem.Models.VaccinationRecord>

<h2>Vaccinations</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Vaccination</a>
</p>

<table class="table table-bordered table-vaccinations">
    <thead>
        <tr>
            <th>Pet</th>
            <th>Vaccine</th>
            <th>Vaccination Date</th>
            <th>Next Due Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isOverdue = item.NextDueDate.HasValue && item.NextDueDate.Value < DateOnly.FromDateTime(DateTime.Today);
            var isDueSoon = item.NextDueDate.HasValue && item.NextDueDate.Value <= DateOnly.FromDateTime(DateTime.Today).AddDays(7) && !isOverdue;
            <tr>
                <td>@item.Pet?.PetName</td>
                <td>@item.VaccineName</td>
                <td>@item.VaccinationDate.ToString("MMM d, yyyy")</td>
                <td>@(item.NextDueDate?.ToString("MMM d, yyyy") ?? "Not set")</td>
                <td>
                    @if (isOverdue)
                    {
                        <span class="status-pill status-pill--danger">Overdue</span>
                    }
                    else if (isDueSoon)
                    {
                        <span class="status-pill status-pill--warning">Due Soon</span>
                    }
                    else
                    {
                        <span class="status-pill status-pill--success">Up to date</span>
                    }
                </td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="table-action-icon table-action-icon--details" title="Details" aria-label="View vaccination details">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="table-action-icon table-action-icon--edit" title="Edit" aria-label="Edit vaccination">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="table-action-icon table-action-icon--delete" title="Delete" aria-label="Delete vaccination">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
