@model IEnumerable<VetClinicSystem.Models.VaccinationRecord>

<h2>Vaccinations</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Vaccination</a>
</p>

<table class="table table-bordered table-vaccinations">
    <thead>
        <tr>
            <th>Pet</th>
            <th>Vaccine</th>
            <th>Vaccination Date</th>
            <th>Next Due Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Pet?.PetName</td>
                <td>@item.VaccineName</td>
                <td>@item.VaccinationDate</td>
                <td>@item.NextDueDate</td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="table-action-icon table-action-icon--details" title="Details" aria-label="View vaccination details">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="table-action-icon table-action-icon--edit" title="Edit" aria-label="Edit vaccination">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="table-action-icon table-action-icon--delete" title="Delete" aria-label="Delete vaccination">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
